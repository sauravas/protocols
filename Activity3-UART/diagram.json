{
  "version": 1,
  "author": "Activity 3 - UART",
  "editor": "wokwi",
  "parts": [
    { "id": "esp", "type": "board-esp32-s3-devkitc-1", "top": 0, "left": 0,
      "attrs": { "env": "micropython-20260406-v1.28.0", "flashSize": "8" } },
    { "id": "r1", "type": "wokwi-resistor", "top": 90, "left": 130, "rotate": 90, "attrs": { "value": "220" } },
    { "id": "led1", "type": "wokwi-led", "top": 190, "left": 125, "attrs": { "color": "red" } }
  ],
  "connections": [
    [ "esp:17", "$serialMonitor:RX", "" ],
    [ "esp:18", "$serialMonitor:TX", "" ],
    [ "esp:2", "r1:1", "green", [ "h20", "v10" ] ],
    [ "r1:2", "led1:A", "green", [ "v10" ] ],
    [ "led1:C", "esp:GND.1", "black", [ "h-20", "v20" ] ]
  ]
}
